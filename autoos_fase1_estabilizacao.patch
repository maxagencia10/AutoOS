+function assert(condition: boolean, testName: string, detail = '') {
+  if (condition) {
+    console.log(`  [PASSOU] ${testName}`);
+    passedTests++;
+  } else {
+    console.error(`  [FALHOU] ${testName} - Detalhe: ${detail}`);
+    failedTests++;
+  }
+}
